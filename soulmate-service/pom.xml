    <description>业务逻辑层</description>

    <dependencies>
        <!-- 内部模块 -->
        <dependency>
            <groupId>com.soulmate</groupId>
            <artifactId>soulmate-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.soulmate</groupId>
