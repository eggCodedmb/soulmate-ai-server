# =============================================
# SoulMate AI 环境变量模板
# 复制此文件为 .env.local 或 .env.production 并填写实际值
# =============================================

# ---------- PostgreSQL ----------
POSTGRES_DB=soulmate
POSTGRES_USER=soulmate
POSTGRES_PASSWORD=          # 必填
POSTGRES_PORT=5432

# ---------- Redis ----------
REDIS_PASSWORD=             # 必填
REDIS_PORT=6379

# ---------- 应用 ----------
APP_PORT=8080
NGINX_PORT=80
NGINX_SSL_PORT=443

# ---------- JWT ----------
JWT_SECRET=                 # 必填，至少32字符

# ---------- AI (MiMo) ----------
MIMO_API_KEY=               # 必填
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# ---------- 邮件 ----------
MAIL_USERNAME=
MAIL_PASSWORD=

# ---------- 和风天气 ----------
QWEATHER_API_KEY=
QWEATHER_API_HOST=https://devapi.qweather.com

# ---------- 支付宝 ----------
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
